        "text": "RAIN GPIO27: LEFT=rain, RIGHT=no rain"
      }
    },
    {
      "type": "wokwi-text",
      "id": "label1",
      "top": -65,
      "left": 230,
      "attrs": {
        "text": "RAIN FAULT GPIO14: LEFT=fault, RIGHT=normal"
      }
    },
    {
      "type": "wokwi-text",
      "id": "label2",
      "top": -65,
      "left": 460,
      "attrs": {
        "text": "LIGHT GPIO34: dial sets 0..200000 lux\nLIGHT FAULT GPIO25: LEFT=fault, RIGHT=normal"
      }
    },
    {
      "type": "wokwi-text",
      "id": "scope",
      "top": 460,
      "left": 0,
      "attrs": {
        "text": "WEATHER01 - simulator only; no actuator output\nSIM_LUX_V1 is not a physical light calibration. Switch is not rain amount."
      }
    }
