    },
    {
      "type": "wokwi-slide-switch",
      "id": "rainFault",
      "top": 110,
      "left": 170,
      "attrs": {
        "value": "1",
        "bounce": "0"
      }
    },
    {
      "type": "wokwi-slide-switch",
      "id": "lightFault",
      "top": 110,
      "left": 340,
      "attrs": {
        "value": "1",
