{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ENV01 configuration ACK",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "deviceId": {
      "const": "ENV01"
    },
    "bootId": {
      "type": "string",
      "format": "uuid"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "configId": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "enum": [
        "APPLIED",
        "REJECTED"
      ]
    },
    "errorCode": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 80
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "schemaVersion",
    "deviceId",
    "bootId",
    "sequence",
    "timestamp",
    "configId",
    "status",
    "errorCode",
    "revision"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "APPLIED"
          }
        }
      },
      "then": {
        "properties": {
          "errorCode": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "errorCode": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
