{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Smart Farm status v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "deviceId": {
      "enum": [
        "ENV01",
        "PUMP01"
      ]
    },
    "bootId": {
      "type": "string",
      "format": "uuid"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "connection": {
      "enum": [
        "ONLINE",
        "OFFLINE"
      ]
    },
    "reportedState": {
      "enum": [
        "ON",
        "OFF",
        "UNKNOWN",
        "ERROR"
      ]
    },
    "activeCommandId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "safetyLockout": {
      "type": "boolean"
    },
    "reason": {
      "type": "string"
    },
    "stateReason": {
      "enum": [
        "BOOT",
        "COMMAND_ON",
        "COMMAND_OFF",
        "LOCKOUT_RESET",
        "TIMER_EXPIRED",
        "CONNECTION_LOST",
        "DEVICE_FAULT",
        "WATER_LOW",
        "FLOW_LOW",
        "FLOW_SENSOR_FAULT",
        "VALVE_NOT_OPEN",
        "VALVE_PROOF_LOST",
        "VALVE_SWITCH_CONFLICT",
        "RESTART_LOCKOUT",
        "SAFETY_STORAGE_FAULT"
      ]
    },
    "commandFence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "lastOrdinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "restartRequired": {
          "type": "boolean"
        }
      },
      "required": [
        "version",
        "lastOrdinal",
        "restartRequired"
      ]
    },
    "valveInterlock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "integer",
          "const": 1
        },
        "enabled": {
          "const": true
        },
        "dataSource": {
          "const": "SIMULATOR"
        },
        "state": {
          "enum": [
            "UNKNOWN",
            "CLOSED",
            "OPEN",
            "CONFLICT"
          ]
        },
        "fault": {
          "enum": [
            null,
            "VALVE_NOT_OPEN",
            "VALVE_PROOF_LOST",
            "VALVE_SWITCH_CONFLICT"
          ]
        },
        "route": {
          "$ref": "#/$defs/pumpCircuitRoute"
        }
      },
      "required": [
        "version",
        "enabled",
        "dataSource",
        "state",
        "fault"
      ]
    },
    "durableSafety": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "integer",
          "const": 1
        },
        "enabled": {
          "const": true
        },
        "storage": {
          "const": "NVS"
        },
        "state": {
          "enum": [
            "READY",
            "ARMED",
            "LOCKED",
            "STORAGE_FAULT"
          ]
        }
      },
      "required": [
        "version",
        "enabled",
        "storage",
        "state"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "deviceId",
    "bootId",
    "sequence",
    "timestamp",
    "connection"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "deviceId": {
            "const": "PUMP01"
          },
          "connection": {
            "const": "ONLINE"
          }
        },
        "required": [
          "deviceId",
          "connection"
        ]
      },
      "then": {
        "required": [
          "reportedState",
          "safetyLockout",
          "activeCommandId"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "stateReason": {
            "enum": [
              "FLOW_LOW",
              "FLOW_SENSOR_FAULT"
            ]
          }
        },
        "required": [
          "stateReason"
        ]
      },
      "then": {
        "properties": {
          "deviceId": {
            "const": "PUMP01"
          },
          "reportedState": {
            "const": "OFF"
          },
          "safetyLockout": {
            "const": true
          }
        },
        "required": [
          "reportedState",
          "safetyLockout"
        ]
      }
    },
    {
      "if": {
        "required": [
          "commandFence"
        ]
      },
      "then": {
        "properties": {
          "deviceId": {
            "const": "PUMP01"
          },
          "connection": {
            "const": "ONLINE"
          }
        },
        "required": [
          "reportedState",
          "safetyLockout"
        ]
      }
    },
    {
      "if": {
        "required": [
          "commandFence"
        ],
        "properties": {
          "commandFence": {
            "properties": {
              "restartRequired": {
                "const": true
              }
            },
            "required": [
              "restartRequired"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "reportedState": {
            "const": "OFF"
          },
          "safetyLockout": {
            "const": true
          }
        },
        "required": [
          "reportedState",
          "safetyLockout"
        ]
      }
    },
    {
      "if": {
        "required": [
          "commandFence"
        ],
        "properties": {
          "commandFence": {
            "properties": {
              "lastOrdinal": {
                "const": 0
              }
            },
            "required": [
              "lastOrdinal"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "reportedState": {
            "const": "OFF"
          }
        },
        "required": [
          "reportedState"
        ]
      }
    },
    {
      "if": {
        "required": [
          "valveInterlock"
        ]
      },
      "then": {
        "properties": {
          "deviceId": {
            "const": "PUMP01"
          },
          "connection": {
            "const": "ONLINE"
          }
        },
        "required": [
          "reportedState",
          "safetyLockout"
        ]
      }
    },
    {
      "if": {
        "required": [
          "durableSafety"
        ]
      },
      "then": {
        "properties": {
          "deviceId": {
            "const": "PUMP01"
          },
          "connection": {
            "const": "ONLINE"
          }
        },
        "required": [
          "reportedState",
          "safetyLockout",
          "commandFence"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "stateReason": {
            "const": "VALVE_NOT_OPEN"
          }
        },
        "required": [
          "stateReason"
        ]
      },
      "then": {
        "required": [
          "valveInterlock"
        ],
        "properties": {
          "valveInterlock": {
            "properties": {
              "fault": {
                "const": "VALVE_NOT_OPEN"
              }
            }
          },
          "reportedState": {
            "const": "OFF"
          },
          "safetyLockout": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stateReason": {
            "const": "VALVE_PROOF_LOST"
          }
        },
        "required": [
          "stateReason"
        ]
      },
      "then": {
        "required": [
          "valveInterlock"
        ],
        "properties": {
          "valveInterlock": {
            "properties": {
              "fault": {
                "const": "VALVE_PROOF_LOST"
              }
            }
          },
          "reportedState": {
            "const": "OFF"
          },
          "safetyLockout": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stateReason": {
            "const": "VALVE_SWITCH_CONFLICT"
          }
        },
        "required": [
          "stateReason"
        ]
      },
      "then": {
        "required": [
          "valveInterlock"
        ],
        "properties": {
          "valveInterlock": {
            "properties": {
              "fault": {
                "const": "VALVE_SWITCH_CONFLICT"
              }
            }
          },
          "reportedState": {
            "const": "OFF"
          },
          "safetyLockout": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "valveInterlock",
          "reportedState"
        ],
        "properties": {
          "reportedState": {
            "const": "ON"
          }
        }
      },
      "then": {
        "allOf": [
          {
            "required": [
              "valveInterlock"
            ],
            "properties": {
              "valveInterlock": {
                "properties": {
                  "state": {
                    "const": "OPEN"
                  },
                  "fault": {
                    "const": null
                  }
                }
              }
            }
          },
          {
            "properties": {
              "safetyLockout": {
                "const": false
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "required": [
          "valveInterlock"
        ],
        "properties": {
          "valveInterlock": {
            "properties": {
              "fault": {
                "type": "string"
              }
            },
            "required": [
              "fault"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "reportedState": {
            "const": "OFF"
          },
          "safetyLockout": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "valveInterlock",
          "stateReason"
        ],
        "properties": {
          "stateReason": {
            "const": "LOCKOUT_RESET"
          }
        }
      },
      "then": {
        "required": [
          "valveInterlock"
        ],
        "properties": {
          "valveInterlock": {
            "properties": {
              "state": {
                "const": "OPEN"
              },
              "fault": {
                "const": null
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stateReason": {
            "const": "RESTART_LOCKOUT"
          }
        },
        "required": [
          "stateReason"
        ]
      },
      "then": {
        "required": [
          "durableSafety"
        ],
        "properties": {
          "durableSafety": {
            "properties": {
              "state": {
                "const": "LOCKED"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stateReason": {
            "const": "SAFETY_STORAGE_FAULT"
          }
        },
        "required": [
          "stateReason"
        ]
      },
      "then": {
        "required": [
          "durableSafety"
        ],
        "properties": {
          "durableSafety": {
            "properties": {
              "state": {
                "const": "STORAGE_FAULT"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "durableSafety"
        ],
        "properties": {
          "durableSafety": {
            "properties": {
              "state": {
                "const": "LOCKED"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "reportedState": {
            "const": "OFF"
          },
          "safetyLockout": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "durableSafety"
        ],
        "properties": {
          "durableSafety": {
            "properties": {
              "state": {
                "const": "STORAGE_FAULT"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "reportedState": {
            "const": "OFF"
          },
          "safetyLockout": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "durableSafety"
        ],
        "properties": {
          "durableSafety": {
            "properties": {
              "state": {
                "const": "READY"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "safetyLockout": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "durableSafety"
        ],
        "properties": {
          "durableSafety": {
            "properties": {
              "state": {
                "const": "ARMED"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "safetyLockout": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "durableSafety"
        ],
        "properties": {
          "durableSafety": {
            "properties": {
              "state": {
                "const": "READY"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "reportedState": {
            "const": "OFF"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "durableSafety",
          "reportedState"
        ],
        "properties": {
          "reportedState": {
            "const": "ON"
          }
        }
      },
      "then": {
        "required": [
          "durableSafety"
        ],
        "properties": {
          "durableSafety": {
            "properties": {
              "state": {
                "const": "ARMED"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "durableSafety",
          "stateReason"
        ],
        "properties": {
          "stateReason": {
            "const": "LOCKOUT_RESET"
          }
        }
      },
      "then": {
        "required": [
          "durableSafety"
        ],
        "properties": {
          "durableSafety": {
            "properties": {
              "state": {
                "const": "READY"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "valveInterlock"
        ],
        "properties": {
          "valveInterlock": {
            "required": [
              "route"
            ]
          }
        }
      },
      "then": {
        "required": [
          "commandFence"
        ]
      }
    }
  ],
  "$defs": {
    "pumpCircuitRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "circuitId",
        "circuitRevision",
        "zoneId",
        "zoneRevision",
        "controllerId",
        "valveId"
      ],
      "properties": {
        "circuitId": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_-]{1,31}$"
        },
        "zoneId": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_-]{1,31}$"
        },
        "circuitRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "zoneRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "controllerId": {
          "type": "string",
          "pattern": "^IRRIGATION(0[2-9]|[1-9][0-9])$"
        },
        "valveId": {
          "type": "string",
          "pattern": "^VALVE(0[2-9]|[1-9][0-9])$"
        }
      }
    }
  }
}
