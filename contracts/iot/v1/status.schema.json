{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Smart Farm status v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "deviceId": {
      "enum": [
        "ENV01",
        "PUMP01"
      ]
    },
    "bootId": {
      "type": "string",
      "format": "uuid"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "connection": {
      "enum": [
        "ONLINE",
        "OFFLINE"
      ]
    },
    "reportedState": {
      "enum": [
        "ON",
        "OFF",
        "UNKNOWN",
        "ERROR"
      ]
    },
    "activeCommandId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "safetyLockout": {
      "type": "boolean"
    },
    "reason": {
      "type": "string"
    },
    "stateReason": {
      "enum": [
        "BOOT",
        "COMMAND_ON",
        "COMMAND_OFF",
        "LOCKOUT_RESET",
        "TIMER_EXPIRED",
        "CONNECTION_LOST",
        "DEVICE_FAULT",
        "WATER_LOW",
        "FLOW_LOW",
        "FLOW_SENSOR_FAULT"
      ]
    },
    "commandFence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "lastOrdinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "restartRequired": {
          "type": "boolean"
        }
      },
      "required": [
        "version",
        "lastOrdinal",
        "restartRequired"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "deviceId",
    "bootId",
    "sequence",
    "timestamp",
    "connection"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "deviceId": {
            "const": "PUMP01"
          },
          "connection": {
            "const": "ONLINE"
          }
        },
        "required": [
          "deviceId",
          "connection"
        ]
      },
      "then": {
        "required": [
          "reportedState",
          "safetyLockout",
          "activeCommandId"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "stateReason": {
            "enum": [
              "FLOW_LOW",
              "FLOW_SENSOR_FAULT"
            ]
          }
        },
        "required": [
          "stateReason"
        ]
      },
      "then": {
        "properties": {
          "deviceId": {
            "const": "PUMP01"
          },
          "reportedState": {
            "const": "OFF"
          },
          "safetyLockout": {
            "const": true
          }
        },
        "required": [
          "reportedState",
          "safetyLockout"
        ]
      }
    },
    {
      "if": {
        "required": [
          "commandFence"
        ]
      },
      "then": {
        "properties": {
          "deviceId": {
            "const": "PUMP01"
          },
          "connection": {
            "const": "ONLINE"
          }
        },
        "required": [
          "reportedState",
          "safetyLockout"
        ]
      }
    },
    {
      "if": {
        "required": [
          "commandFence"
        ],
        "properties": {
          "commandFence": {
            "properties": {
              "restartRequired": {
                "const": true
              }
            },
            "required": [
              "restartRequired"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "reportedState": {
            "const": "OFF"
          },
          "safetyLockout": {
            "const": true
          }
        },
        "required": [
          "reportedState",
          "safetyLockout"
        ]
      }
    },
    {
      "if": {
        "required": [
          "commandFence"
        ],
        "properties": {
          "commandFence": {
            "properties": {
              "lastOrdinal": {
                "const": 0
              }
            },
            "required": [
              "lastOrdinal"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "reportedState": {
            "const": "OFF"
          }
        },
        "required": [
          "reportedState"
        ]
      }
    }
  ]
}
