{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Smart Farm command v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "commandId": {
      "type": "string",
      "format": "uuid"
    },
    "deviceId": {
      "const": "PUMP01"
    },
    "action": {
      "enum": [
        "ON",
        "OFF",
        "RESET_LOCKOUT"
      ]
    },
    "durationSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "commandFence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "ordinal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "targetBootId": {
          "type": "string",
          "format": "uuid"
        },
        "route": {
          "$ref": "#/$defs/pumpCircuitRoute"
        }
      },
      "required": [
        "version",
        "ordinal",
        "targetBootId"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "commandId",
    "deviceId",
    "action",
    "issuedAt",
    "expiresAt"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "ON"
          }
        }
      },
      "then": {
        "required": [
          "durationSeconds"
        ]
      },
      "else": {
        "not": {
          "required": [
            "durationSeconds"
          ]
        }
      }
    },
    {
      "if": {
        "required": [
          "commandFence"
        ],
        "properties": {
          "commandFence": {
            "required": [
              "route"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "action": {
            "enum": [
              "ON",
              "RESET_LOCKOUT"
            ]
          },
          "durationSeconds": {
            "maximum": 30
          }
        }
      }
    }
  ],
  "$defs": {
    "pumpCircuitRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "circuitId",
        "circuitRevision",
        "zoneId",
        "zoneRevision",
        "controllerId",
        "valveId"
      ],
      "properties": {
        "circuitId": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_-]{1,31}$"
        },
        "zoneId": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_-]{1,31}$"
        },
        "circuitRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "zoneRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "controllerId": {
          "type": "string",
          "pattern": "^IRRIGATION(0[2-9]|[1-9][0-9])$"
        },
        "valveId": {
          "type": "string",
          "pattern": "^VALVE(0[2-9]|[1-9][0-9])$"
        }
      }
    }
  }
}
