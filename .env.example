# Mẫu biến môi trường cho backend Spring Boot (backend/src/main/resources/application.yml).
# Không commit giá trị thật. Mật khẩu DB local được tạo tự động vào
# .local/postgres/db.env bởi: python tools/backend/init_local_database.py

# PostgreSQL (compose.yaml mở cổng 127.0.0.1:5433)
SMARTFARM_DB_URL=jdbc:postgresql://127.0.0.1:5433/smartfarm
SMARTFARM_DB_USER=smartfarm
SMARTFARM_DB_PASSWORD=CHANGE_ME

# Cổng API backend (Vite proxy /api -> http://127.0.0.1:8080)
SERVER_PORT=8080

# MQTT/AWS IoT — tắt mặc định; chỉ bật khi đã cấu hình AWS profile và IAM policy
SMARTFARM_MQTT_ENABLED=false
AWS_REGION=ap-southeast-1
AWS_PROFILE=smartfarm
AWS_IOT_ENDPOINT=YOUR_DATA_ATS_HOSTNAME

# Điều khiển bơm qua MQTT — tắt mặc định. API hiện CHƯA có xác thực:
# không bật trên máy có thể truy cập từ mạng ngoài.
SMARTFARM_CONTROL_ENABLED=false
